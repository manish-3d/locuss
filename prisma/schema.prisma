generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  price       Int
  bedrooms    Int
  bathrooms   Int
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}